{
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "js": [
        "md.js",
        "context.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "Copy links, images, selections and pages as clean Markdown. No accounts, no servers, no noise.",
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "Markdown Minimal",
  "permissions": [
    "contextMenus",
    "clipboardWrite",
    "activeTab"
  ],
  "version": "1.2.1"
}
